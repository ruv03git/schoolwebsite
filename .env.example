# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign login tokens. Generate a long random value:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=replace-with-a-long-random-string

# Where the SQLite database lives. Keep it OUTSIDE this repository.
# Windows example: C:\school-data\school.db
# Linux example:   /var/lib/school/school.db
DB_PATH=./school.db
